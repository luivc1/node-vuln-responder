# =====================================================================
#  Advisory file: single source of truth for every script and skill.
#  For a future Node.js security release: copy this file, update the
#  values from nodejs.org, and pass --advisory <file> to any script.
# =====================================================================

ADVISORY_ID="nodejs-2026-10"
ADVISORY_NAME="Node.js October 2026 security releases"
CVES="CVE-2026-111497 CVE-2026-105482 CVE-2026-105483 CVE-2026-106069 CVE-2026-105481 CVE-2026-106072 CVE-2026-106074 CVE-2026-106070 CVE-2026-106071 CVE-2026-106073"
SEVERITY="High (max). Includes CVE-2026-111497, Brotli decoder out-of-bounds write permitting remote code execution, plus TLS hostname-verification bypasses."

# High-severity CVEs affecting every supported line. A distro changelog must
# list all of these before a backport counts as confirmed.
BACKPORT_KEY_CVES="CVE-2026-111497 CVE-2026-106069 CVE-2026-105482"

# First patched release per supported major (space separated).
FIXED_VERSIONS="26.12.1 24.22.1 22.23.4"

# Line to move end-of-life apps to (an LTS line with the longest support left)
RECOMMENDED_UPGRADE_MAJOR="24"

# Docker/nvm LTS codenames -> major (do not guess codenames not yet announced)
LTS_CODENAMES="hydrogen=18 iron=20 jod=22 krypton=24"

# Bundled dependencies updated in this release (no versions published):
# c-ares, CA certificates (eMudhra intermediate CA compromise), OpenSSL (22/24),
# SQLite (22), undici. Apps that install undici directly from npm: npm audit.

RELEASE_DATE="2026-10-21"
# No exploitation date was published. Default compromise-hunt lookback is
# 14 days before the release; widen it for high-risk, internet-facing apps.
IOC_SINCE="2026-10-07"

MITIGATION_NOTE="nodejs.org lists no workarounds; upgrading Node to a fixed release (or a supported line for EOL versions) is the remediation. Until then, for HTTP2Shell (CVE-2026-111497) only: block Content-Encoding: br request bodies at the proxy/WAF, set inflate:false on Express 5 body parsers (also rejects gzip bodies), and isolate services that fetch untrusted URLs. Do not strip br from Accept-Encoding: a malicious server can still send Brotli."

# ---------------------------------------------------------------------
# HTTP2Shell (CVE-2026-111497, also "Node2Shell"): the same Google Brotli
# decoder bug reaches beyond the Node binary. No confirmed in-the-wild
# exploitation as of 2026-10-24 (not in CISA KEV); lab RCE shown on 24.22.0.
# Clear these values in a future advisory that is not about Brotli.
# ---------------------------------------------------------------------
BROTLI_CVE="CVE-2026-111497"
# Upstream Brotli: 1.0.3 through 1.2.0 affected; fixed per branch
BROTLI_AFFECTED="1.0.3 to 1.2.0"
BROTLI_FIXED_UPSTREAM="1.0.10 1.1.1 1.2.1"
# Distro builds of the shared library with the fix (Debian 12, Debian 13).
# Others: the package changelog must list BROTLI_CVE. Ubuntu: under evaluation.
BROTLI_FIXED_DISTRO="1.0.9-2+deb12u1 1.1.0-2+deb13u1"
# Bun ships its own Brotli decoder
BUN_FIXED="1.4.4"
# Express 5 (body-parser 2.x) decodes Brotli request bodies by default; Express 4
# (body-parser 1.x) rejects them with 415. Separately, body-parser below these
# versions crashes on compressed bodies with trailing bytes (DoS).
BODYPARSER_FIXED="2.4.0 1.20.9"
BODYPARSER_ADVISORY="CVE-2026-111181 / GHSA-27r3-jxmh-p828"

SOURCE_URL="https://nodejs.org/en/blog/vulnerability/october-2026-security-releases"
SOURCES="https://nodejs.org/en/blog/vulnerability/october-2026-security-releases | https://endoflife.date/nodejs | https://security-tracker.debian.org/tracker/CVE-2026-111497 | https://ubuntu.com/security/CVE-2026-111497 | https://github.com/expressjs/body-parser/security/advisories/GHSA-27r3-jxmh-p828 | https://bun.com/blog/bun-v1.4.4 | https://strobes.co/blog/http2shell-brotli-rce-cve-2026-111497/"
LAST_VERIFIED="2026-10-24"
