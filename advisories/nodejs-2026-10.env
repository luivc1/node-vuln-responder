# =====================================================================
#  Advisory file: single source of truth for every script and skill.
#  For a future Node.js security release: copy this file, update the
#  values from nodejs.org, and pass --advisory <file> to any script.
# =====================================================================

ADVISORY_ID="nodejs-2026-10"
ADVISORY_NAME="Node.js October 2026 security releases"
CVES="CVE-2026-111497 CVE-2026-105482 CVE-2026-105483 CVE-2026-106069 CVE-2026-105481 CVE-2026-106072 CVE-2026-106074 CVE-2026-106070 CVE-2026-106071 CVE-2026-106073"
SEVERITY="High (max). Includes CVE-2026-111497, Brotli decoder out-of-bounds write permitting remote code execution, plus TLS hostname-verification bypasses."

# High-severity CVEs affecting every supported line. A distro changelog must
# list all of these before a backport counts as confirmed.
BACKPORT_KEY_CVES="CVE-2026-111497 CVE-2026-106069 CVE-2026-105482"

# First patched release per supported major (space separated).
FIXED_VERSIONS="26.12.1 24.22.1 22.23.4"

# Line to move end-of-life apps to (an LTS line with the longest support left)
RECOMMENDED_UPGRADE_MAJOR="24"

# Docker/nvm LTS codenames -> major (do not guess codenames not yet announced)
LTS_CODENAMES="hydrogen=18 iron=20 jod=22 krypton=24"

# Bundled dependencies updated in this release (no versions published):
# c-ares, CA certificates (eMudhra intermediate CA compromise), OpenSSL (22/24),
# SQLite (22), undici. Apps that install undici directly from npm: npm audit.

RELEASE_DATE="2026-10-21"
# No exploitation date was published. Default compromise-hunt lookback is
# 14 days before the release; widen it for high-risk, internet-facing apps.
IOC_SINCE="2026-10-07"

MITIGATION_NOTE="nodejs.org lists no workarounds. Upgrading Node to a fixed release (or a supported line for EOL versions) is the only remediation."

SOURCE_URL="https://nodejs.org/en/blog/vulnerability/october-2026-security-releases"
SOURCES="https://nodejs.org/en/blog/vulnerability/october-2026-security-releases | https://endoflife.date/nodejs"
LAST_VERIFIED="2026-10-21"
